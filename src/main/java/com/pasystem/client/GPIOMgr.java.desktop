package com.pasystem.client;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import java.util.Scanner;

public class GPIOMgr {

	class GPIOPin {
		public String name;
		public boolean active;
		public boolean was_pressed;

		public GPIOPin(String name) {
			this.name = name;
		}
	}

	private static ArrayList<GPIOPin> gpio_list = new ArrayList<>();
	private static boolean instance_created = false;

	public GPIOMgr(Map<String, Integer> gpio_map) {

		if (instance_created) {
			System.out.println(
				"[GPIOMgr] Only one instance is allowed to exist, " +
				"then this is meant to be used as a static utility"
			);
			return;
		}

		instance_created = true;

		System.out.println("[GPIOMgr] Starting desktop GPIO management");

		for (String name : gpio_map.keySet()) {
			System.out.println(
				"[GPIOMgr] Creating virtual GPIO '" + name + "'"
			);

			gpio_list.add(new GPIOPin(name));
		}

		new Thread(() -> {
			Scanner scanner = new Scanner(System.in);

			while (true) {
				String input = scanner.nextLine().trim();

				if (input.isEmpty()) {
					continue;
				}

				char letter = Character.toUpperCase(input.charAt(0));

				List<GPIOPin> matches = new ArrayList<>();

				for (GPIOPin pin : gpio_list) {
					if (!pin.name.isEmpty()
							&& Character.toUpperCase(pin.name.charAt(0)) == letter) {
						matches.add(pin);
					}
				}

				if (matches.isEmpty()) {
					System.out.println(
						"[GPIOMgr] No GPIO pins found starting with '" + letter + "'"
					);
					continue;
				}

				GPIOPin selected;

				if (matches.size() == 1) {
					selected = matches.get(0);
				} else {
					System.out.println("Enter #:");

					for (int i = 0; i < matches.size(); i++) {
						System.out.println(
							"\n" + (i + 1) + ")" + matches.get(i).name
						);
					}

					System.out.print("\n> ");

					String numberInput = scanner.nextLine().trim();

					int number;

					try {
						number = Integer.parseInt(numberInput);
					} catch (NumberFormatException e) {
						System.out.println("[GPIOMgr] Invalid number");
						continue;
					}

					if (number < 1 || number > matches.size()) {
						System.out.println("[GPIOMgr] Invalid selection");
						continue;
					}

					selected = matches.get(number - 1);
				}

				// Toggle the virtual GPIO
				selected.active = !selected.active;
				selected.was_pressed = selected.active;

				System.out.println(
					"[GPIOMgr] " + selected.name + " = "
					+ (selected.active ? "ON" : "OFF")
				);
			}
		}, "GPIOMgr-Scanner").start();
	}

	public static boolean is_pressed(String name) {

		for (GPIOPin current_pin : gpio_list) {
			if (current_pin.name.equals(name) && current_pin.active) {
				current_pin.active = false;
				current_pin.was_pressed = false;
				return true;
			}
		}

		return false;
	}

	public static boolean is_down(String name) {

		for (GPIOPin current_pin : gpio_list) {
			if (current_pin.name.equals(name)) {
				return current_pin.was_pressed;
			}
		}

		return false;
	}
}
